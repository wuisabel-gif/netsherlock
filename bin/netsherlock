#!/usr/bin/env perl

use strict;
use warnings;

use FindBin qw($Bin);
use lib "$Bin/../lib";

use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP ();
use Time::HiRes ();

use NetSherlock ();
use NetSherlock::Config;
use NetSherlock::DNS;
use NetSherlock::Diagnose;
use NetSherlock::Ping;
use NetSherlock::Port;
use NetSherlock::Reporter;
use NetSherlock::Result;
use NetSherlock::Trace;
use NetSherlock::Triage;
use NetSherlock::Dashboard;
use NetSherlock::Alert;

exit main(@ARGV);

sub main {
    my @args = @_;
    my %options;

    my $parsed = GetOptionsFromArray(
        \@args,
        'help|h'      => \$options{help},
        'version|v'   => \$options{version},
        'json'        => \$options{json},
        'timeout=f'   => \$options{timeout},
        'verbose'     => \$options{verbose},
        'quiet'       => \$options{quiet},
        'max-hops=i'  => \$options{max_hops},
        'window=f'    => \$options{window},
        'rate=i'      => \$options{rate},
        'fails=i'     => \$options{fails},
        'interval=f'  => \$options{interval},
        'once'        => \$options{once},
        'recent=i'    => \$options{recent},
        'top=i'       => \$options{top},
        'webhook=s'       => \$options{webhook},
        'webhook-format=s'=> \$options{webhook_format},
        'min-confidence=f'=> \$options{min_confidence},
        'debounce=f'  => \$options{debounce},
        'dry-run!'    => \$options{dry_run},
        'from-start'  => \$options{from_start},
    );

    if ( !$parsed ) {
        print STDERR "Try 'netsherlock --help' for usage.\n";
        return 2;
    }

    if ( $options{version} ) {
        print "NetSherlock $NetSherlock::VERSION\n";
        return 0;
    }

    my $command = shift @args;
    if ( !defined $command ) {
        print $options{help} ? usage() : usage();
        return $options{help} ? 0 : 2;
    }

    if ( $options{help} ) {
        print command_usage($command);
        return 0;
    }

    if ( $command eq 'help' ) {
        print command_usage( shift(@args) // '' );
        return 0;
    }

    if ( $command !~ /^(?:ping|port|dns|trace|inspect|triage|dashboard|alert)$/ ) {
        print STDERR "Unknown command '$command'.\n";
        print STDERR "Try 'netsherlock --help' for usage.\n";
        return 2;
    }

    my $timeout = defined $options{timeout} ? $options{timeout} : 5;
    if ( $timeout <= 0 ) {
        print STDERR "--timeout must be greater than zero.\n";
        return 2;
    }
    if ( defined $options{max_hops} && $options{max_hops} < 1 ) {
        print STDERR "--max-hops must be greater than zero.\n";
        return 2;
    }
    $options{timeout} = $timeout;

    my $validation_error = _validate_arguments( $command, \@args );
    if ($validation_error) {
        print STDERR "$validation_error\n";
        print STDERR command_usage($command);
        return 2;
    }

    my $logger = $options{verbose} ? sub { print STDERR "[debug] $_[0]\n" } : undef;

    # The live views manage their own output loop rather than the one-shot
    # report -> Reporter path, so dispatch them here.
    if ( $command eq 'dashboard' ) {
        return _run_dashboard( $args[0], \%options, $logger );
    }
    if ( $command eq 'alert' ) {
        return _run_alert( $args[0], \%options, $logger );
    }

    my ( $report, $exit_code );

    my $ok = eval {
        if ( $command eq 'dns' ) {
            $report = _run_dns( $args[0], \%options, $logger );
        }
        elsif ( $command eq 'ping' ) {
            $report = _run_ping( $args[0], \%options, $logger );
        }
        elsif ( $command eq 'port' ) {
            $report = _run_port( $args[0], $args[1], \%options, $logger );
        }
        elsif ( $command eq 'trace' ) {
            $report = _run_trace( $args[0], \%options, $logger );
        }
        elsif ( $command eq 'inspect' ) {
            $report = _run_inspect( $args[0], \%options, $logger );
        }
        elsif ( $command eq 'triage' ) {
            $report = _run_triage( $args[0], \%options, $logger );
        }
        1;
    };

    if ( !$ok ) {
        my $error = $@ || 'unknown internal error';
        chomp $error;
        if ( $command eq 'inspect' ) {
            print STDERR "Invalid configuration: $error\n";
            return 2;
        }
        if ( $command eq 'triage' ) {
            print STDERR "Cannot ingest log: $error\n";
            return 2;
        }
        print STDERR "NetSherlock internal error: $error\n";
        return 3;
    }

    if ( $options{json} ) {
        print NetSherlock::Reporter::json(
            results   => $report->{results},
            diagnosis => $report->{diagnosis},
            extra     => $report->{extra},
        );
    }
    else {
        print NetSherlock::Reporter::human(
            title     => $report->{title},
            target    => $report->{target},
            results   => $report->{results},
            diagnosis => $report->{diagnosis},
            groups    => $report->{groups},
            quiet     => $options{quiet},
        );
    }

    return _exit_code( $report->{results}, $report->{diagnosis} );
}

sub _run_dns {
    my ( $host, $options, $logger ) = @_;
    my $result = _dns_with_timeout( $host, $options->{timeout}, $logger );
    return _report( "DNS: $host", $host, [$result] );
}

sub _run_ping {
    my ( $host, $options, $logger ) = @_;
    my @results;
    my $dns = _dns_with_timeout( $host, $options->{timeout}, $logger );
    push @results, $dns;

    if ( $dns->success ) {
        push @results, NetSherlock::Ping::check(
            host     => $host,
            timeout  => $options->{timeout},
            logger   => $logger,
        );
    }
    else {
        push @results, _skipped( 'ping', $host, 'DNS resolution failed' );
    }

    return _report( "Ping: $host", $host, \@results );
}

sub _run_port {
    my ( $host, $port, $options, $logger ) = @_;
    my @results;
    my $dns = _dns_with_timeout( $host, $options->{timeout}, $logger );
    push @results, $dns;

    if ( $dns->success ) {
        push @results, NetSherlock::Ping::check(
            host    => $host,
            timeout => $options->{timeout},
            logger  => $logger,
        );
        push @results, NetSherlock::Port::check(
            host    => $host,
            port    => $port,
            timeout => $options->{timeout},
            logger  => $logger,
        );
    }
    else {
        push @results, _skipped( 'ping', $host, 'DNS resolution failed' );
        push @results, _skipped( 'tcp', $host, 'DNS resolution failed', $port );
    }

    return _report( "Port: $host:$port", "$host:$port", \@results );
}

sub _run_trace {
    my ( $host, $options, $logger ) = @_;
    my @results;
    my $dns = _dns_with_timeout( $host, $options->{timeout}, $logger );
    push @results, $dns;

    if ( $dns->success ) {
        my ($address) = grep { /\./ } @{ $dns->detail->{addresses} || [] };
        $address //= $dns->detail->{addresses}[0];
        push @results, NetSherlock::Trace::check(
            host             => $address,
            display_target   => $host,
            expected_address => $address,
            timeout          => $options->{timeout},
            max_hops         => $options->{max_hops} // 30,
            logger           => $logger,
        );
    }
    else {
        push @results, _skipped( 'trace', $host, 'DNS resolution failed' );
    }

    return _report( "Trace: $host", $host, \@results );
}

sub _run_inspect {
    my ( $path, $options, $logger ) = @_;
    my $config = NetSherlock::Config->load_file($path);
    my @all_results;
    my @check_reports;

    for my $index ( 0 .. $#{ $config->{checks} || [] } ) {
        my $check = $config->{checks}[$index];
        my $to = $check->{to};
        my $host = $config->{hosts}{$to}{address};
        my $label = "check[$index] $check->{from} -> $to $check->{protocol}/$check->{port}";
        my @results;

        if ( $check->{from} ne 'local' ) {
            push @results, NetSherlock::Result->new(
                check   => 'tcp',
                target  => $host,
                port    => $check->{port},
                success => 0,
                status  => 'unsupported',
                error   => "remote source '$check->{from}' is not implemented yet",
                detail  => { from => $check->{from}, to => $to },
            );
        }
        else {
            my $dns = _dns_with_timeout( $host, $options->{timeout}, $logger );
            push @results, $dns;
            if ( $dns->success ) {
                push @results, NetSherlock::Port::check(
                    host    => $host,
                    port    => $check->{port},
                    timeout => $options->{timeout},
                    logger  => $logger,
                );
            }
            else {
                push @results, _skipped( 'tcp', $host, 'DNS resolution failed', $check->{port} );
            }
        }

        my $diagnosis = NetSherlock::Diagnose::analyze( results => \@results );
        push @all_results, @results;
        push @check_reports,
          {
            name      => $label,
            target    => $host . ':' . $check->{port},
            results   => \@results,
            diagnosis => $diagnosis,
          };
    }

    my @all_interpretations = map { @{ $_->{diagnosis}{interpretations} || [] } } @check_reports;
    my @all_facts = map { @{ $_->{diagnosis}{facts} || [] } } @check_reports;
    my @all_next = map { @{ $_->{diagnosis}{next_steps} || [] } } @check_reports;
    my $failed = grep { !$_->success } @all_results;
    my $diagnosis = {
        summary         => $failed ? 'One or more configured checks failed.' : 'All configured checks succeeded.',
        facts           => \@all_facts,
        interpretations => \@all_interpretations,
        next_steps      => \@all_next,
        has_failure     => $failed ? 1 : 0,
        checks          => [ map { { name => $_->{name}, diagnosis => $_->{diagnosis} } } @check_reports ],
    };

    return {
        title     => 'NetSherlock configuration inspection',
        target    => $path,
        results   => \@all_results,
        diagnosis => $diagnosis,
        extra     => {
            configuration => $config,
            checks        => [
                map {
                    {
                        name      => $_->{name},
                        target    => $_->{target},
                        results   => [ map { $_->to_hash } @{ $_->{results} || [] } ],
                        diagnosis => $_->{diagnosis},
                    }
                } @check_reports
            ],
        },
        groups    => \@check_reports,
    };
}

sub _run_triage {
    my ( $path, $options, $logger ) = @_;
    die "no such file '$path'\n" unless -e $path;

    open my $fh, '<', $path or die "cannot read '$path': $!\n";
    local $/;
    my $text = <$fh>;
    close $fh;

    $logger->("ingesting request records from $path") if $logger;
    my $records = NetSherlock::Triage::parse_log($text);
    my $report  = NetSherlock::Triage::classify(
        records => $records,
        window  => $options->{window},
        rate    => $options->{rate},
        fails   => $options->{fails},
    );
    $logger->( "classified $report->{total} record(s), flagged $report->{flagged}" ) if $logger;

    my @facts = map { "$report->{categories}{$_} request(s) matched $_." }
      sort keys %{ $report->{categories} };
    my $summary = sprintf(
        'Flagged %d of %d ingested request(s) as likely attack traffic; %d served as legitimate.',
        $report->{flagged}, $report->{total}, $report->{clean},
    );

    my @next_steps;
    if ( $report->{flagged} ) {
        push @next_steps,
          'Review the flagged requests and confirm against application and WAF logs before acting.';
        push @next_steps,
          'These are behavior- and content-based signals, not IP reputation; the same source may send both legitimate and hostile requests.';
    }

    my $diagnosis = {
        summary         => $summary,
        facts           => \@facts,
        interpretations => NetSherlock::Triage::interpretations_for( $report->{categories} ),
        next_steps      => \@next_steps,
        has_failure     => $report->{flagged} ? 1 : 0,
    };

    return {
        title     => "Traffic triage: $path",
        target    => $path,
        results   => $report->{results},
        diagnosis => $diagnosis,
        extra     => {
            summary => {
                total      => $report->{total},
                flagged    => $report->{flagged},
                clean      => $report->{clean},
                categories => $report->{categories},
            },
        },
    };
}

# Feature A: refreshing terminal dashboard over the same log triage ingests.
sub _run_dashboard {
    my ( $path, $options, $logger ) = @_;
    die "no such file '$path'\n" unless -e $path;

    my $interval = defined $options->{interval} ? $options->{interval} : 2;
    # One-shot when asked, when piped (not a TTY), or when the interval is zero.
    my $once = $options->{once} || $interval <= 0 || !( -t STDOUT );

    my $draw = sub {
        my $records = NetSherlock::Triage::parse_log( _slurp($path) );
        my $report  = NetSherlock::Triage::classify(
            records => $records,
            window  => $options->{window},
            rate    => $options->{rate},
            fails   => $options->{fails},
        );
        my $board = NetSherlock::Dashboard::render(
            report  => $report,
            records => $records,
            path    => $path,
            recent  => $options->{recent},
            top     => $options->{top},
        );
        return ( $board, $report->{flagged} );
    };

    if ($once) {
        my ( $board, $flagged ) = $draw->();
        print $board;
        return $flagged ? 1 : 0;
    }

    local $SIG{INT} = sub { print "\e[2J\e[H"; exit 0 };    # clean exit on Ctrl-C
    $logger->("dashboard refreshing every ${interval}s; Ctrl-C to stop") if $logger;
    while (1) {
        my ( $board ) = $draw->();
        print "\e[2J\e[H", $board, "\n(refreshing every ${interval}s - Ctrl-C to stop)\n";
        Time::HiRes::sleep($interval);
    }
    return 0;
}

# Feature B: tail -F the log and POST an alert when a request is flagged above
# the confidence threshold. Dry-run by default; debounced so one scan is one
# alert, not five hundred.
sub _run_alert {
    my ( $path, $options, $logger ) = @_;
    die "no such file '$path'\n" unless -e $path;

    my $dry_run = defined $options->{dry_run} ? $options->{dry_run} : 1;    # default dry-run
    my $webhook = defined $options->{webhook} ? $options->{webhook} : $ENV{NETSHERLOCK_WEBHOOK};
    my $min     = defined $options->{min_confidence} ? $options->{min_confidence} : $NetSherlock::Triage::THRESHOLD;
    my $interval= defined $options->{interval} ? $options->{interval} : 1;

    if ( !$dry_run && !( defined $webhook && length $webhook ) ) {
        die "live alerting needs a webhook (--webhook URL or NETSHERLOCK_WEBHOOK); use --dry-run to preview\n";
    }

    my $alert = NetSherlock::Alert->new(
        url      => $webhook,
        format   => $options->{webhook_format},
        debounce => $options->{debounce},
        dry_run  => $dry_run,
    );

    # Rolling buffer of recent records so aggregate signals (brute-force, rate)
    # still fire in a stream, not just per-request content. ponytail: bounded
    # buffer + full reclassify per tick; fine for human-scale logs, swap for an
    # incremental scorer if a firehose ever needs it.
    my $MAX = 2000;
    my ( @buf, $seq, %alerted );

    my $feed = sub {
        my ($text) = @_;
        my $recs = NetSherlock::Triage::parse_log($text);
        return unless @$recs;
        $_->{line} = ++$seq for @$recs;    # stable global id for dedup
        push @buf, @$recs;
        splice @buf, 0, @buf - $MAX if @buf > $MAX;

        my $report = NetSherlock::Triage::classify(
            records => \@buf,
            window  => $options->{window},
            rate    => $options->{rate},
            fails   => $options->{fails},
        );
        for my $r ( @{ $report->{results} } ) {
            my $d  = $r->detail || {};
            my $id = $d->{line};
            next if defined $id && $alerted{$id}++;    # alert each request once
            next if ( $d->{confidence} || 0 ) < $min;
            my $out = $alert->deliver($r);
            _report_alert( $out, $dry_run );
        }
    };

    if ( $options->{once} ) {
        $feed->( _slurp($path) );
        printf STDERR "alert: %d sent, %d suppressed (dry-run=%d)\n",
          $alert->{sent}, $alert->{suppressed}, $dry_run if $logger;
        return 0;
    }

    # tail -F: start at EOF unless --from-start, then poll for appended lines
    # and reopen on truncation/rotation.
    open my $fh, '<', $path or die "cannot read '$path': $!\n";
    my $pos = $options->{from_start} ? 0 : ( -s $path );
    seek $fh, $pos, 0;
    local $SIG{INT} = sub { exit 0 };
    $logger->("watching $path (dry-run=$dry_run, min-confidence=$min); Ctrl-C to stop") if $logger;
    while (1) {
        my @new;
        while ( my $line = <$fh> ) { push @new, $line }
        $feed->( join( '', @new ) ) if @new;
        seek $fh, 0, 1;    # clear EOF so the next read sees appended data

        my $size = -s $path;
        if ( defined $size && $size < tell($fh) ) {    # rotated/truncated
            close $fh;
            open $fh, '<', $path or die "cannot reopen '$path': $!\n";
        }
        Time::HiRes::sleep($interval);
    }
    return 0;
}

sub _report_alert {
    my ( $out, $dry_run ) = @_;
    my $payload = $out->{payload};
    my $text = $payload ? ( $payload->{text} // $payload->{content} // '' ) : '';
    if ( $out->{dry_run} ) {
        print "[dry-run] would POST: $text\n";
    }
    elsif ( $out->{sent} ) {
        print "[sent] $text\n";
    }
    elsif ( $out->{error} ) {
        print STDERR "[error] $out->{error}: $text\n";
    }
    return;
}

sub _slurp {
    my ($path) = @_;
    open my $fh, '<', $path or die "cannot read '$path': $!\n";
    local $/;
    my $text = <$fh>;
    close $fh;
    return $text;
}

sub _dns_with_timeout {
    my ( $host, $timeout, $logger ) = @_;
    my $result;
    my $timed_out = 0;

    eval {
        local $SIG{ALRM} = sub { die "DNS timeout\n" };
        Time::HiRes::alarm($timeout);
        $result = NetSherlock::DNS::resolve( host => $host, logger => $logger );
        Time::HiRes::alarm(0);
    };
    my $error = $@;
    Time::HiRes::alarm(0);

    if ($error) {
        chomp $error;
        $timed_out = 1 if $error eq 'DNS timeout';
        return NetSherlock::Result->new(
            check   => 'dns',
            target  => $host,
            success => 0,
            status  => $timed_out ? 'timeout' : 'unknown',
            error   => $timed_out ? "resolver exceeded the ${timeout}s timeout" : $error,
        );
    }

    return $result;
}

sub _skipped {
    my ( $check, $target, $reason, $port ) = @_;
    return NetSherlock::Result->new(
        check   => $check,
        target  => $target,
        port    => $port,
        success => 0,
        status  => 'skipped',
        error   => $reason,
    );
}

sub _report {
    my ( $title, $target, $results ) = @_;
    return {
        title     => $title,
        target    => $target,
        results   => $results,
        diagnosis => NetSherlock::Diagnose::analyze( results => $results ),
        extra     => {},
    };
}

sub _exit_code {
    my ( $results, $diagnosis ) = @_;
    return 0 unless $diagnosis->{has_failure};

    # An unsupported remote source is a valid but unavailable feature, not a
    # network observation. Treat it as an invalid/unsupported configuration.
    return 2 if grep { $_->status eq 'unsupported' } @$results;
    return 1;
}

sub _validate_arguments {
    my ( $command, $args ) = @_;
    my %counts = ( ping => 1, dns => 1, trace => 1, port => 2, inspect => 1, triage => 1, dashboard => 1, alert => 1 );
    my $expected = $counts{$command};
    return "'$command' requires $expected argument" if @$args < $expected;
    return "'$command' accepts exactly $expected argument(s)" if @$args > $expected;

    for my $arg (@$args) {
        return 'arguments must not be empty' unless defined $arg && length $arg;
        return "invalid argument '$arg'" if $arg =~ /^-/ || $arg =~ /[\0\n\r]/;
    }

    if ( $command eq 'port' ) {
        return 'PORT must be an integer from 1 to 65535'
          unless $args->[1] =~ /^\d+$/ && $args->[1] >= 1 && $args->[1] <= 65535;
    }

    return undef;
}

sub usage {
    return <<'USAGE';
Usage: netsherlock [OPTIONS] COMMAND [ARGS]

Evidence-driven network diagnostics for ordinary hosts and services.

Commands:
  ping HOST             Check basic host reachability
  port HOST PORT        Check DNS, reachability, and a TCP port
  dns HOST              Resolve a hostname
  trace HOST            Record the route toward a host
  inspect CONFIG        Run local checks from a JSON or simple YAML config
  triage LOGFILE        Flag likely attack traffic in an access log by behavior
  dashboard LOGFILE     Live, refreshing attack-detection dashboard over a log
  alert LOGFILE         Watch a log and POST webhook alerts on flagged attacks

Options:
  --json                Emit machine-readable JSON
  --timeout SECONDS     Bound network operations (default: 5; trace uses 5 too)
  --max-hops N          Maximum route hops (default: 30)
  --window SECONDS      triage/dashboard/alert: rate/brute-force bucket width (default: 10)
  --rate N              triage/dashboard/alert: requests/window/path before "abnormal" (default: 20)
  --fails N             triage/dashboard/alert: failed auths/window/path before "brute-force" (default: 5)
  --interval SECONDS    dashboard: redraw interval; alert: tail poll interval (default 2 / 1)
  --once                dashboard/alert: process the log once and exit (no loop)
  --recent N            dashboard: how many recent flagged requests to list (default 8)
  --top N               dashboard: how many top source addresses to list (default 5)
  --webhook URL         alert: Slack/Discord incoming-webhook URL (or NETSHERLOCK_WEBHOOK)
  --webhook-format F    alert: slack | discord | auto (default auto, inferred from URL)
  --min-confidence C    alert: only alert at/above this confidence (default 0.5)
  --debounce SECONDS    alert: collapse repeat alerts per category+path (default 60)
  --dry-run             alert: print what would be sent without posting (default on)
  --no-dry-run          alert: actually POST (requires a webhook URL)
  --from-start          alert: scan the whole file first, not just new lines
  --verbose             Write diagnostic steps to stderr
  --quiet               Suppress individual observations in human output
  --help                Show this help
  --version             Show the version

Exit codes:
  0  requested diagnostic succeeded
  1  a network or service failure was observed
  2  invalid command, arguments, or configuration
  3  internal error
USAGE
}

sub command_usage {
    my ($command) = @_;
    return usage() unless defined $command && length $command;
    return "Usage: netsherlock $command HOST [OPTIONS]\n\n"
      . ( $command eq 'ping'  ? 'Check host reachability without assuming a failed probe means the host is down.\n'
        : $command eq 'dns'   ? 'Resolve HOST using the operating system resolver.\n'
        : $command eq 'trace' ? 'Record the route toward HOST using the system traceroute tool.\n'
        : $command eq 'port'  ? 'Check DNS, reachability, and a TCP service port.\nUsage: netsherlock port HOST PORT [OPTIONS]\n'
        : $command eq 'inspect' ? 'Run checks from a generic local-diagnostics configuration file.\n'
        : $command eq 'triage' ? "Flag likely attack traffic in an access log by request behavior, not source IP.\nUsage: netsherlock triage LOGFILE [--window S] [--rate N] [--fails N]\n"
        : $command eq 'dashboard' ? "Live, refreshing dashboard of attack traffic in an access log.\nUsage: netsherlock dashboard LOGFILE [--interval S] [--recent N] [--top N] [--once]\n"
        : $command eq 'alert' ? "Watch a log and POST a Slack/Discord webhook alert on each flagged attack.\nUsage: netsherlock alert LOGFILE [--webhook URL] [--min-confidence C] [--debounce S] [--dry-run] [--once]\n"
        : "Unknown command '$command'.\n" )
      . "\nOptions may be placed before or after the command.\n";
}
